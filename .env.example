# 本地运行配置示例。复制为 .env 后填写；不要提交真实密钥。

# mock | real；默认 mock 不调用微信 API
WECHAT_MODE=mock

# 仅 real 模式需要
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# real 模式必须使用真实、非空封面；也可以给每篇文章单独绑定封面
WECHAT_DEFAULT_THUMB_PATH=

# 调度；同名环境变量优先于 config/rules.yaml，合集规则可再覆盖单个合集
SCHEDULE_WINDOW_DAYS=7
SCHEDULER_POLL_SECONDS=60
MAX_ARTICLES_PER_DAY=2
MAX_JOB_RETRIES=3
DRY_RUN=false

# 本地路径
DATABASE_PATH=data/app.sqlite3
ARTICLES_INBOX=articles/inbox
RULES_PATH=config/rules.yaml

# 日志；LOG_FILE=none 可关闭文件日志
LOG_FILE=data/logs/app.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3
LOG_LEVEL=INFO

# Web 工作台仅供本机使用
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Web、scheduler-daemon、cron 三种执行器只启用一种
WEB_AUTO_RUN_DUE=true

# 外部 Agent 任务包；这些环境变量优先于 config/rules.yaml 中的同名能力配置
EXTERNAL_AGENT_TASK_EXPORT_ENABLED=true
EXTERNAL_AGENT_TASK_OUTBOX=outbox/wechat_agent_tasks
EXTERNAL_AGENT_INCLUDE_ARTICLE_PREVIEW=true
EXTERNAL_AGENT_INCLUDE_COVER=true
EXTERNAL_AGENT_INCLUDE_PROMPT=true
